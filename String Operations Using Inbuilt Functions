#include <stdio.h>
#include <string.h>
int main()
{
char str1[100];
char str2[100];
char copy[100];
char reverse[100];
int length;
int i;
int result;
printf("Enter first string: ");
scanf(" %[^\n]", str1);
printf("Enter second string:");
scanf(" %[^\n]", str2);
/* 5.1 Copy one string into another */
strcpy(copy, str1);
printf("\n5.1 Copy Operation:\n");
printf("Copied string = %s\n", copy);
/* 5.2 Reverse the string */
strcpy(reverse, str1);
length = strlen(reverse);
for (i = 0; i < length / 2; i++)
{
char temp;
temp = reverse[i];
reverse[i] = reverse[length - 1 - i];
reverse[length - 1 - i] = temp;
}
printf("\n5.2 Reverse Operation:\n");
printf("Reverse of first string = %s\n", reverse);
